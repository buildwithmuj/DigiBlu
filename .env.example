# Copy to .env.local for local work. In Cloudflare, the NEXT_PUBLIC_
# variables are BUILD variables (inlined into the bundle at build time, so a
# change needs a rebuild); everything else is read by the Worker at request
# time, so it is a Worker variable or, for the two secrets, a Worker secret.

# Google Analytics 4 measurement id (Admin > Data streams > Web). A
# measurement id is visible to every visitor by design; it is kept out of
# the source so production and previews can use different properties, or
# previews none at all. Leave empty to build with no analytics: the consent
# banner then offers no Analytics category and loads nothing from Google.
# Production (set in Cloudflare's build variables) is G-RVNLDVSLJ8, the
# "digiblu.com" web stream of the "DigiBlu website" property. Empty here on
# purpose: a local build with it set reports to the live property once
# analytics is accepted. Set it in .env.local only to test analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# The public origin, used for canonical URLs, share cards, sitemap and robots.
# Defaults to https://www.digiblu.com; set it only where the site must claim a
# different host. Read at request time on the Worker (most pages render on
# request), so it is a Worker variable, not only a build variable.
# SITE_ORIGIN=https://www.digiblu.com

# Set to "noindex" on every non-production environment (Cloudflare previews,
# UAT): robots.txt disallows all and every response carries
# X-Robots-Tag: noindex, so search engines never index a preview. Leave
# unset in production.
# NEXT_PUBLIC_ROBOTS=noindex

# Cloudflare Turnstile, the contact form's bot check (11 Sep 2026). The site
# key is public and inlined into the page at build time; the secret is used
# only by the API route and must be a Worker secret in production
# (wrangler secret put TURNSTILE_SECRET_KEY), never a build variable.
# These are Cloudflare's documented test keys: the widget always passes and
# the verify call always succeeds. Production keys come from DigiBlu's
# developer (Cloudflare dashboard > Turnstile > Add widget, hostname
# digiblu.com).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA


# Azure Communication Services (ACS), which sends the contact form's
# enquiry email (14 Sep 2026). The connection string is a Worker secret
# (wrangler secret put AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING),
# never a build variable; the sender must be an address on a verified ACS
# domain and the recipient is the inbox the enquiries go to. All three are
# read by /api/contact at request time; without them the route answers 500.
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
CONTACT_FORM_SENDER_EMAIL_ADDRESS=DoNotReply@19680b91-bf21-492f-888d-d01bc9b1480f.azurecomm.net
CONTACT_FORM_RECIPIENT_EMAIL_ADDRESS=recipient@example.com