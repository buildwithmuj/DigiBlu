{
  "name": "digiblu-website",
  "version": "2.0.0-next",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "runtime": { "name": "node", "version": "^24.0.0", "onFail": "download" }
  },
  "scripts": {
    "content": "node scripts/build-content.cjs",
    "prebuild": "pnpm run content",
    "pretest": "pnpm run content",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "node --conditions=browser --test scripts/content.test.cjs scripts/contact.test.cjs",
    "test:pages": "node --test scripts/pages.test.cjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "pnpm run content && vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "pnpm run content && vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "gray-matter": "4.0.3",
    "marked": "16.4.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vanilla-cookieconsent": "3.1.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "wrangler": "^4.137.0"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module"
}
